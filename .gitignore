# ==============================================================================
# DDXPlus Dataset & Raw Patient Records
# (Note: Large patient files exceed GitHub's 100MB limit and are downloaded via
# backend/data/ddxplus/download_dataset.py. Metadata JSONs are kept in git.)
# ==============================================================================
backend/data/ddxplus/raw/*.zip
backend/data/ddxplus/raw/*.csv
backend/data/ddxplus/raw/*.parquet
backend/data/ddxplus/raw/*.tar.gz
backend/data/ddxplus/raw/release_train_patients*
backend/data/ddxplus/raw/release_validate_patients*
backend/data/ddxplus/raw/release_test_patients*
!backend/data/ddxplus/raw/release_conditions.json
!backend/data/ddxplus/raw/release_evidences.json

